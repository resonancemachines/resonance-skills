{
  "glossary": {
    "name": "ResonanceDomainCatalog",
    "displayName": "Resonance Platform Domain Aggregate Catalog",
    "description": "Enterprise catalog of 22 Domain Aggregate Roots across 8 Bounded Contexts governing Transactional Outbox CDC routing and Kafka partition keys per Vernon IDDD and DDIA Ch. 6.",
    "mutuallyExclusive": false,
    "tags": ["Architecture.DDD", "Platform.Resonance", "Data.Mesh"]
  },
  "domains": [
    {
      "name": "StorageAndVFS",
      "displayName": "Storage & Virtual File System (VFS)",
      "description": "Hierarchical document storage, node management, chunking, and file metadata ingestion."
    },
    {
      "name": "OperationalIngress",
      "displayName": "Operational Ingress & Actions",
      "description": "User and AI agent intent signaling, action telemetry, and transient download streaming."
    },
    {
      "name": "ReliabilityAndSupport",
      "displayName": "Reliability & Operational Support",
      "description": "Incident ticket resolution, poisoned event dead-letter quarantine (DLQ), and support task assignment."
    },
    {
      "name": "OrganizationAndIdentity",
      "displayName": "Organization & Identity",
      "description": "Tenant organization root boundaries, workspaces, and team access memberships."
    },
    {
      "name": "WorkflowAndOrchestration",
      "displayName": "Workflow & Saga Orchestration",
      "description": "Long-running choreographed/orchestrated distributed sagas, approval gates, and heavy background compute jobs."
    },
    {
      "name": "SemanticBrain",
      "displayName": "Semantic Brain & Knowledge Graph",
      "description": "Unified context graph, Schema.org entity projections, ontology subgraphs, and vector embeddings."
    },
    {
      "name": "SecurityAndCryptography",
      "displayName": "Security & Cryptography",
      "description": "Token vault entries for PII tokenization and cryptographic file entitlement policies."
    },
    {
      "name": "ControlBillingAndEgress",
      "displayName": "Control Plane, Metering & Webhooks",
      "description": "Service mesh feature gates, tenant token usage metering, streaming delivery products, and outbound webhook delivery."
    }
  ],
